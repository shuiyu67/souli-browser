<template>
  <div class="keyboard" if="{{visible}}">
    <!-- 输入显示区 -->
    <div class="input-display">
      <text class="input-text">{{inputValue || placeholder}}</text>
      <div class="clear-btn" onclick="handleClear">
        <text class="clear-icon">X</text>
      </div>
    </div>
    
    <!-- 数字行 -->
    <div class="row">
      <div class="key" onclick="handleKey('1')"><text class="key-text">1</text></div>
      <div class="key" onclick="handleKey('2')"><text class="key-text">2</text></div>
      <div class="key" onclick="handleKey('3')"><text class="key-text">3</text></div>
      <div class="key" onclick="handleKey('4')"><text class="key-text">4</text></div>
      <div class="key" onclick="handleKey('5')"><text class="key-text">5</text></div>
      <div class="key" onclick="handleKey('6')"><text class="key-text">6</text></div>
      <div class="key" onclick="handleKey('7')"><text class="key-text">7</text></div>
      <div class="key" onclick="handleKey('8')"><text class="key-text">8</text></div>
      <div class="key" onclick="handleKey('9')"><text class="key-text">9</text></div>
      <div class="key" onclick="handleKey('0')"><text class="key-text">0</text></div>
    </div>
    
    <!-- QWERTY第一行 -->
    <div class="row">
      <div class="key" onclick="handleKey('q')"><text class="key-text">Q</text></div>
      <div class="key" onclick="handleKey('w')"><text class="key-text">W</text></div>
      <div class="key" onclick="handleKey('e')"><text class="key-text">E</text></div>
      <div class="key" onclick="handleKey('r')"><text class="key-text">R</text></div>
      <div class="key" onclick="handleKey('t')"><text class="key-text">T</text></div>
      <div class="key" onclick="handleKey('y')"><text class="key-text">Y</text></div>
      <div class="key" onclick="handleKey('u')"><text class="key-text">U</text></div>
      <div class="key" onclick="handleKey('i')"><text class="key-text">I</text></div>
      <div class="key" onclick="handleKey('o')"><text class="key-text">O</text></div>
      <div class="key" onclick="handleKey('p')"><text class="key-text">P</text></div>
    </div>
    
    <!-- QWERTY第二行 -->
    <div class="row">
      <div class="key" onclick="handleKey('a')"><text class="key-text">A</text></div>
      <div class="key" onclick="handleKey('s')"><text class="key-text">S</text></div>
      <div class="key" onclick="handleKey('d')"><text class="key-text">D</text></div>
      <div class="key" onclick="handleKey('f')"><text class="key-text">F</text></div>
      <div class="key" onclick="handleKey('g')"><text class="key-text">G</text></div>
      <div class="key" onclick="handleKey('h')"><text class="key-text">H</text></div>
      <div class="key" onclick="handleKey('j')"><text class="key-text">J</text></div>
      <div class="key" onclick="handleKey('k')"><text class="key-text">K</text></div>
      <div class="key" onclick="handleKey('l')"><text class="key-text">L</text></div>
      <div class="key" onclick="handleKey('.')"><text class="key-text">.</text></div>
    </div>
    
    <!-- QWERTY第三行 -->
    <div class="row">
      <div class="key" onclick="handleKey('z')"><text class="key-text">Z</text></div>
      <div class="key" onclick="handleKey('x')"><text class="key-text">X</text></div>
      <div class="key" onclick="handleKey('c')"><text class="key-text">C</text></div>
      <div class="key" onclick="handleKey('v')"><text class="key-text">V</text></div>
      <div class="key" onclick="handleKey('b')"><text class="key-text">B</text></div>
      <div class="key" onclick="handleKey('n')"><text class="key-text">N</text></div>
      <div class="key" onclick="handleKey('m')"><text class="key-text">M</text></div>
      <div class="key" onclick="handleKey('-')"><text class="key-text">-</text></div>
      <div class="key" onclick="handleKey('/')"><text class="key-text">/</text></div>
      <div class="key del-key" onclick="handleDelete">
        <text class="key-text"><-</text>
      </div>
    </div>
    
    <!-- 快捷输入行 -->
    <div class="row">
      <div class="key action-key" onclick="handleKey('https://')">
        <text class="action-text">https://</text>
      </div>
      <div class="key action-key" onclick="handleKey('www.')">
        <text class="action-text">www.</text>
      </div>
      <div class="key action-key" onclick="handleKey('.com')">
        <text class="action-text">.com</text>
      </div>
    </div>
    
    <!-- 底部操作行 -->
    <div class="control-row">
      <div class="ctrl-btn cancel-btn" onclick="handleCancel">
        <text class="ctrl-text">取消</text>
      </div>
      <div class="ctrl-btn confirm-btn" onclick="handleConfirm">
        <text class="ctrl-text">前往</text>
      </div>
    </div>
  </div>
</template>

<script>
export default {
  props: {
    visible: {
      default: false
    },
    inputValue: {
      default: ""
    },
    placeholder: {
      default: "输入网址"
    }
  },
  
  handleKey(char) {
    this.$emit("keyinput", { value: char })
  },
  
  handleDelete() {
    this.$emit("keydelete", {})
  },
  
  handleClear() {
    this.$emit("keyclear", {})
  },
  
  handleCancel() {
    this.$emit("keycancel", {})
  },
  
  handleConfirm() {
    this.$emit("keyconfirm", {})
  }
}
</script>

