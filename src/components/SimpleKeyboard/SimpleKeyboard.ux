.control-row {
  flex-direction: row;
  justify-content: space-between;
  margin-top: 4px;
  padding: 0 4px;
}

.ctrl-btn {
  flex: 1;
  height: 40px;
  margin: 0 4px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
}

.cancel-btn {
  background-color: #3a3a3c;
}

.confirm-btn {
  background-color: #0a84ff;
}

