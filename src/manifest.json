{
  "package": "com.xinflow.browser",
  "name": "搜哩浏览器",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.webview"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.fetch"
    },
    {
      "name": "system.vibrator"
    },
    {
      "name": "system.device"
    },
    {
      "name": "system.network"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 336,
    "trustedUrl": [
      "*"
    ]
  },
  "router": {
    "entry": "pages/home",
    "pages": {
      "pages/home": {
        "component": "home"
      },
      "pages/index": {
        "component": "index"
      },
      "pages/detail": {
        "component": "detail"
      },
      "pages/offline": {
        "component": "offline"
      },
      "pages/about": {
        "component": "about"
      },
      "pages/settings": {
        "component": "settings"
      }
    }
  }
}