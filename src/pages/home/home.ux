  background-color: #1c1c1e;
  border-radius: 16px;
  align-items: center;
  justify-content: center;
  border: 1px solid #2c2c2e;
}

.menu-icon-wrapper {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-bottom: 6px;
}

.menu-icon {
  color: #ffffff;
