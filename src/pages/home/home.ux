  height: 90px;
}

.fav-list {
  flex-direction: row;
  padding: 0 16px;
}

.fav-card {
  width: 140px;
  height: 80px;
  background-color: #1c1c1e;
  border-radius: 12px;
  padding: 12px;
  margin-right: 10px;
  flex-direction: column;
  justify-content: flex-end;
  border: 1px solid #2c2c2e;
}

.fav-color {
  position: absolute;
