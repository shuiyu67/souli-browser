  color: #98989d;
  font-size: 11px;
}

/* 收藏夹 */
.fav-section {
  margin-bottom: 20px;
}

.section-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 0 20px;
  margin-bottom: 12px;
}

.section-title {
  color: #ffffff;
  font-size: 15px;
  font-weight: 600;
}

.section-more {
  color: #0a84ff;
  font-size: 12px;
}

