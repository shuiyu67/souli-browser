<template>
  <div class="page">
    <div class="header">
      <div class="back-btn" onclick="goBack">
        <text class="back-icon">&lt;</text>
      </div>
      <text class="title">离线页面</text>
      <div class="edit-btn" if="{{pages.length > 0}}" onclick="toggleEdit">
        <text class="edit-text">{{isEditing ? '完成' : '编辑'}}</text>
      </div>
    </div>

    <scroll class="content" scroll-y="true" if="{{pages.length > 0}}">
      <div class="list">
        <div class="item" for="{{(index, item) in pages}}">
          <div class="delete-btn" if="{{isEditing}}" onclick="deletePage($idx)">
            <text class="delete-icon">−</text>
          </div>
          <div class="item-content" onclick="openPage($idx)">
            <div class="item-info">
              <text class="item-title">{{item.title || '无标题'}}</text>
              <text class="item-url">{{formatUrl(item.url)}}</text>
              <div class="item-meta">
                <text class="meta-text">{{item.saveTime}}</text>
                <text class="meta-text" if="{{item.elements}}">{{item.elements.length}} 项</text>
              </div>
            </div>
            <text class="item-arrow" if="{{!isEditing}}">›</text>
          </div>
        </div>
      </div>
    </scroll>

    <div class="empty" if="{{pages.length === 0}}">
      <text class="empty-icon">=</text>
      <text class="empty-text">暂无离线页面</text>
      <text class="empty-desc">浏览网页时选择"保存离线页面"</text>
    </div>

    <div class="toast" if="{{showToast}}">
      <text class="toast-text">{{toastMsg}}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import { getStorageData, setStorageData, formatDisplayUrl, truncateText } from "../../common/utils.js"

export default {
  private: {
    pages: [],
    isEditing: false,
    showToast: false,
    toastMsg: ''
  },

  onShow() {
    this.loadPages()
  },

  async loadPages() {
    const data = await getStorageData(storage, 'offline_pages')
    this.pages = data.map(p => ({
      ...p,
      title: truncateText(p.title, 30)
    }))
  },

  formatUrl(url) {
    return formatDisplayUrl(url)
  },

  openPage(index) {
    if (this.isEditing) return
    
    const page = this.pages[index]
    if (!page) return

    if (page.elements && page.elements.length > 0) {
      const tempId = 'offline_' + Date.now()
      const offlineData = {
        title: page.title,
        url: page.url,
        elements: page.elements
      }
      
      storage.set({
        key: tempId,
        value: JSON.stringify(offlineData),
        success: () => {
          router.push({ uri: 'pages/index', params: { tempId } })
        }
      })
    } else if (page.url) {
      router.push({ uri: 'pages/index', params: { url: page.url } })
    }
  },

  toggleEdit() {
    this.isEditing = !this.isEditing
  },

  async deletePage(index) {
    const item = this.pages[index]
    this.pages.splice(index, 1)

    const success = await setStorageData(storage, 'offline_pages', this.pages)
    if (success) {
      this.showTip('已删除')
      if (this.pages.length === 0) {
        this.isEditing = false
      }
    } else {
      this.showTip('删除失败')
      this.pages.splice(index, 0, item)
    }
  },

  showTip(msg) {
    this.toastMsg = msg
    this.showToast = true
    setTimeout(() => this.showToast = false, 2000)
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  height: 480px;
  background-color: #000;
}

.header {
  height: 44px;
  flex-direction: row;
  align-items: center;
  padding: 0 10px;
  background-color: #1c1c1e;
}

.back-btn {
  width: 32px;
  height: 32px;
  border-radius: 16px;
  background-color: #2c2c2e;
  justify-content: center;
  align-items: center;
}

.back-icon {
  color: #0a84ff;
  font-size: 18px;
}

.title {
  flex: 1;
  text-align: center;
  color: #fff;
  font-size: 17px;
  font-weight: 600;
}

.edit-btn {
  padding: 6px 12px;
  border-radius: 6px;
  background-color: #2c2c2e;
}

.edit-text {
  color: #0a84ff;
  font-size: 14px;
}

.content {
  height: 436px;
}

.list {
  padding: 8px;
}

.item {
  flex-direction: row;
  align-items: center;
  margin-bottom: 6px;
  border-radius: 12px;
  background-color: #1c1c1e;
}

.delete-btn {
  width: 28px;
  height: 28px;
  border-radius: 14px;
  background-color: #ff453a;
  justify-content: center;
  align-items: center;
  margin-left: 12px;
}

.delete-icon {
  color: #fff;
  font-size: 18px;
  font-weight: bold;
}

.item-content {
  flex: 1;
  flex-direction: row;
  align-items: center;
  padding: 12px;
}

.item-info {
  flex: 1;
  flex-direction: column;
}

.item-title {
  color: #fff;
  font-size: 15px;
  font-weight: 500;
}

.item-url {
  color: #8e8e93;
  font-size: 11px;
  margin-top: 2px;
}

.item-meta {
  flex-direction: row;
  margin-top: 4px;
}

.meta-text {
  color: #48484a;
  font-size: 10px;
  margin-right: 8px;
}

.item-arrow {
  color: #48484a;
  font-size: 18px;
}

.empty {
  flex: 1;
  justify-content: center;
  align-items: center;
}

.empty-icon {
  color: #3a3a3c;
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-text {
  color: #8e8e93;
  font-size: 16px;
  margin-bottom: 8px;
}

.empty-desc {
  color: #48484a;
  font-size: 13px;
}

.toast {
  position: fixed;
  bottom: 80px;
  left: 0;
  right: 0;
  justify-content: center;
  padding: 10px 20px;
  border-radius: 20px;
  background-color: rgba(48, 209, 88, 0.95);
}

.toast-text {
  color: #fff;
  font-size: 14px;
}
</style>